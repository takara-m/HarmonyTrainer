import { useState, useEffect } from 'react'
import { useLocation, useNavigate, useParams, useSearchParams } from 'react-router-dom'
import { SAMPLE_SONGS } from './Songs'
import ResultModal from '../components/ResultModal'
import styles from './Practice.module.css'

// 度数のオプション
const DEGREES = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII']
const CHORD_TYPES = ['', 'm', '7', 'm7', 'maj7', 'dim', 'aug']

// 仮の正解データ（本来はSAMPLE_SONGSに含める）
const CORRECT_ANSWERS = {
  '1': [ // カノン進行
    { degree: 'I', type: '' },
    { degree: 'V', type: '' },
    { degree: 'VI', type: 'm' },
    { degree: 'III', type: 'm' },
  ],
  '2': [ // 王道進行
    { degree: 'IV', type: '' },
    { degree: 'V', type: '' },
    { degree: 'III', type: 'm' },
    { degree: 'VI', type: 'm' },
  ],
  '3': [ // ブルース進行
    { degree: 'I', type: '7' },
    { degree: 'IV', type: '7' },
    { degree: 'V', type: '7' },
  ],
}

function Practice() {
  const { id } = useParams()
  const [searchParams] = useSearchParams()
  const mode = searchParams.get('mode') // 'random', 'asc', 'desc'
  const location = useLocation()
  const navigate = useNavigate()

  // 現在の曲を取得
  const currentSong = SAMPLE_SONGS.find(s => s.id === id) || location.state?.song || SAMPLE_SONGS[0]

  const [selectedMeasure, setSelectedMeasure] = useState(null)
  const [userInput, setUserInput] = useState({})
  const [showModal, setShowModal] = useState(false)

  // 曲が変わったら入力をリセット
  useEffect(() => {
    setSelectedMeasure(null)
    setUserInput({})
    setShowModal(false)
  }, [id])

  const handleDegreeSelect = (degree) => {
    if (selectedMeasure === null) {
      alert('先に小節を選択してください')
      return
    }
    const currentInput = userInput[selectedMeasure] || { degree: '', type: '' }
    setUserInput({
      ...userInput,
      [selectedMeasure]: { ...currentInput, degree },
    })
  }

  const handleTypeSelect = (type) => {
    if (selectedMeasure === null) {
      alert('先に小節を選択してください')
      return
    }
    const currentInput = userInput[selectedMeasure] || { degree: '', type: '' }
    if (!currentInput.degree) {
      alert('先に度数を選択してください')
      return
    }
    setUserInput({
      ...userInput,
      [selectedMeasure]: { ...currentInput, type },
    })
  }

  const handlePlayMock = () => {
    alert('音声再生機能（モック実装）')
  }

  const getNextSong = () => {
    const currentIndex = SAMPLE_SONGS.findIndex(s => s.id === id)

    if (!mode) {
      // モードなし（単独練習）の場合は次の曲なし
      return null
    }

    if (mode === 'random') {
      // ランダム：現在の曲以外をランダムに選択
      const otherSongs = SAMPLE_SONGS.filter(s => s.id !== id)
      if (otherSongs.length === 0) return null
      return otherSongs[Math.floor(Math.random() * otherSongs.length)]
    } else if (mode === 'asc') {
      // 昇順：次の曲へ
      if (currentIndex < SAMPLE_SONGS.length - 1) {
        return SAMPLE_SONGS[currentIndex + 1]
      }
      return null // 最後の曲
    } else if (mode === 'desc') {
      // 降順：前の曲へ
      if (currentIndex > 0) {
        return SAMPLE_SONGS[currentIndex - 1]
      }
      return null // 最初の曲（降順では最後）
    }
    return null
  }

  const handleCheckAnswer = () => {
    // モーダルを表示
    setShowModal(true)
  }

  const handleNextSong = () => {
    const nextSong = getNextSong()
    if (nextSong) {
      navigate(`/practice/${nextSong.id}?mode=${mode}`, {
        state: { song: nextSong }
      })
    } else {
      // 全曲終了
      alert('お疲れ様でした！\n全ての曲が終了しました。')
      navigate('/')
    }
    setShowModal(false)
  }

  const handleBackModal = () => {
    // モーダルを閉じるだけ
    setShowModal(false)
  }

  const handleCloseModal = () => {
    // トップに戻る
    setShowModal(false)
    navigate('/')
  }

  // 正解データを取得
  const correctAnswers = CORRECT_ANSWERS[id] || []

  // userInputを配列形式に変換
  const userAnswers = Array.from({ length: currentSong.measures || 4 }, (_, i) =>
    userInput[i] || null
  )

  return (
    <div className={styles.container}>
      <header className={styles.header}>
        <button className={styles.backButton} onClick={() => navigate('/')}>
          ← 戻る
        </button>
        <h1 className={styles.title}>練習モード</h1>
      </header>

      <main className={styles.main}>
        {/* 曲情報 */}
        <div className={styles.songInfoCard}>
          <h2 className={styles.songTitle}>{currentSong.title}</h2>
          <p className={styles.keyInfo}>キー: {currentSong.key}</p>
          {mode && (
            <p className={styles.modeInfo}>
              モード: {mode === 'random' ? 'ランダム' : mode === 'asc' ? '昇順' : '降順'}
            </p>
          )}
        </div>

        {/* 再生ボタン */}
        <button className={styles.playButton} onClick={handlePlayMock}>
          ▶ 再生
        </button>

        {/* 小節表示 */}
        <section className={styles.section}>
          <h3 className={styles.sectionTitle}>小節を選択</h3>
          <div className={styles.measuresRow}>
            {Array.from({ length: currentSong.measures || 4 }, (_, i) => {
              const input = userInput[i]
              const displayText = input && input.degree
                ? `${input.degree}${input.type}`
                : '?'

              return (
                <button
                  key={i}
                  className={`${styles.measureBox} ${
                    selectedMeasure === i ? styles.measureBoxSelected : ''
                  }`}
                  onClick={() => setSelectedMeasure(i)}
                >
                  <span className={styles.measureNumber}>{i + 1}</span>
                  <span className={styles.measureInput}>{displayText}</span>
                </button>
              )
            })}
          </div>
        </section>

        {/* 度数選択 */}
        <section className={styles.section}>
          <h3 className={styles.sectionTitle}>度数を選択</h3>
          <div className={styles.degreeRow}>
            {DEGREES.map((degree) => (
              <button
                key={degree}
                className={styles.degreeButton}
                onClick={() => handleDegreeSelect(degree)}
              >
                {degree}
              </button>
            ))}
          </div>
        </section>

        {/* コードタイプ選択 */}
        <section className={styles.section}>
          <h3 className={styles.sectionTitle}>コードタイプ（オプション）</h3>
          <div className={styles.typeRow}>
            {CHORD_TYPES.map((type) => (
              <button
                key={type || 'major'}
                className={styles.typeButton}
                onClick={() => handleTypeSelect(type)}
              >
                {type || 'メジャー'}
              </button>
            ))}
          </div>
        </section>

        {/* 採点ボタン */}
        <button className={styles.checkButton} onClick={handleCheckAnswer}>
          答え合わせ
        </button>
      </main>

      {/* 結果モーダル */}
      <ResultModal
        isOpen={showModal}
        onClose={handleCloseModal}
        onBack={handleBackModal}
        onNextSong={handleNextSong}
        correctAnswers={correctAnswers}
        userAnswers={userAnswers}
        hasNextSong={!!getNextSong()}
      />
    </div>
  )
}

export default Practice
