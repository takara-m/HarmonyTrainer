import styles from './ResultModal.module.css'

function ResultModal({
  isOpen,
  onClose,
  onBack,
  onNextSong,
  correctAnswers,
  userAnswers,
  hasNextSong
}) {
  if (!isOpen) return null

  // 正解数を計算
  const totalQuestions = correctAnswers.length
  const correctCount = correctAnswers.filter((correct, index) => {
    const user = userAnswers[index]
    if (!user || !correct) return false
    return user.degree === correct.degree && user.type === correct.type
  }).length

  const isAllCorrect = correctCount === totalQuestions
  const scorePercentage = Math.round((correctCount / totalQuestions) * 100)

  return (
    <div className={styles.overlay} onClick={onBack}>
      <div className={styles.modal} onClick={(e) => e.stopPropagation()}>
        <div className={styles.header}>
          <h2 className={styles.title}>
            {isAllCorrect ? '🎉 Perfect!' : '結果発表'}
          </h2>
        </div>

        <div className={styles.content}>
          {/* スコア表示 */}
          <div className={styles.scoreSection}>
            <div className={styles.scoreCircle}>
              <span className={styles.scoreNumber}>{correctCount}</span>
              <span className={styles.scoreDivider}>/</span>
              <span className={styles.scoreTotal}>{totalQuestions}</span>
            </div>
            <p className={styles.scoreText}>
              正解率: {scorePercentage}%
            </p>
          </div>

          {/* 答え合わせ */}
          <div className={styles.answersSection}>
            <h3 className={styles.sectionTitle}>答え合わせ</h3>
            <div className={styles.answersList}>
              {correctAnswers.map((correct, index) => {
                const user = userAnswers[index]
                const isCorrect =
                  user &&
                  user.degree === correct.degree &&
                  user.type === correct.type

                return (
                  <div key={index} className={styles.answerRow}>
                    <div className={styles.measureLabel}>
                      小節 {index + 1}
                    </div>
                    <div className={styles.answerComparison}>
                      <div className={`${styles.answerBox} ${styles.userAnswer}`}>
                        <span className={styles.answerLabel}>あなた:</span>
                        <span className={styles.answerValue}>
                          {user ? `${user.degree}${user.type}` : '未回答'}
                        </span>
                      </div>
                      <div className={`${styles.answerBox} ${styles.correctAnswer}`}>
                        <span className={styles.answerLabel}>正解:</span>
                        <span className={styles.answerValue}>
                          {correct.degree}{correct.type}
                        </span>
                      </div>
                    </div>
                    <div className={styles.resultIcon}>
                      {isCorrect ? '✅' : '❌'}
                    </div>
                  </div>
                )
              })}
            </div>
          </div>
        </div>

        {/* アクションボタン */}
        <div className={styles.actions}>
          {hasNextSong && (
            <button className={styles.nextButton} onClick={onNextSong}>
              次の曲へ →
            </button>
          )}
          <button className={styles.continueButton} onClick={onBack}>
            前の画面に戻る
          </button>
          <button className={styles.backButton} onClick={onClose}>
            トップに戻る
          </button>
        </div>
      </div>
    </div>
  )
}

export default ResultModal
